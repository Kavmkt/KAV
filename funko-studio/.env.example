# Chave da OpenAI (https://platform.openai.com/api-keys). Sem ela o app roda em MODO DEMO.
OPENAI_API_KEY=

# Modelo de imagem. Troque aqui quando quiser usar outra versão (ex.: gpt-image-1.5 ou o mais novo disponível na sua conta).
OPENAI_IMAGE_MODEL=gpt-image-1

# Segredo para assinar o contador de tentativas (qualquer texto longo e aleatório).
QUOTA_SECRET=troque-por-um-texto-longo-e-aleatorio

# Limite de tentativas por cliente.
MAX_ATTEMPTS=15

# Qualidade: low | medium | high (medium = bom equilíbrio custo/qualidade)
IMAGE_QUALITY=medium
